{
  "rules": {
    "clinics": {
      "main": {
        "settings": {
          ".read": true,
          ".write": "auth != null"
        },
        "days": {
          "$day": {
            "counter": {
              ".read": true,
              ".write": "auth != null || newData.val() === (data.exists() ? data.val() : 0) + 1",
              ".validate": "newData.isNumber()"
            },
            "queue": {
              ".read": true,
              "$id": {
                ".write": "auth != null || (!data.exists() && newData.child('status').val() === 'waiting' && !newData.child('startedAt').exists() && !newData.child('doneAt').exists() && newData.child('no').val() >= 1 && newData.child('no').val() <= root.child('clinics').child('main').child('days').child($day).child('counter').val() && root.child('clinics').child('main').child('days').child($day).child('private').child($id).exists())",
                ".validate": "$day.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.hasChildren(['no','status','createdAt'])",
                "no": {
                  ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() % 1 === 0"
                },
                "first": {
                  ".validate": "newData.isString() && newData.val().length <= 30"
                },
                "status": {
                  ".write": "auth != null || (data.val() === 'waiting' && newData.val() === 'cancelled')",
                  ".validate": "newData.val() === 'waiting' || newData.val() === 'in' || newData.val() === 'done' || newData.val() === 'noshow' || newData.val() === 'cancelled'"
                },
                "createdAt": {
                  ".validate": "newData.isNumber()"
                },
                "startedAt": {
                  ".validate": "newData.isNumber()"
                },
                "doneAt": {
                  ".validate": "newData.isNumber()"
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "private": {
              ".read": "auth != null",
              "$id": {
                ".write": "auth != null || (!data.exists() && newData.child('src').val() === 'qr' && !newData.child('waAt').exists() && (root.child('clinics').child('main').child('days').child($day).child('codeOn').val() === true && newData.child('code').val() === root.child('clinics').child('main').child('days').child($day).child('code').val()))",
                ".validate": "$day.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.hasChildren(['name','src'])",
                "name": {
                  ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100"
                },
                "phone": {
                  ".validate": "newData.isString() && newData.val().length <= 20"
                },
                "age": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 130"
                },
                "gender": {
                  ".validate": "newData.isString() && newData.val().length <= 20"
                },
                "type": {
                  ".validate": "newData.isString() && newData.val().length <= 40"
                },
                "why": {
                  ".validate": "newData.isString() && newData.val().length <= 1000"
                },
                "chronic": {
                  ".validate": "newData.isString() && newData.val().length <= 1000"
                },
                "src": {
                  ".validate": "newData.val() === 'qr' || newData.val() === 'staff'"
                },
                "code": {
                  ".validate": "newData.isString() && newData.val().length <= 8"
                },
                "waAt": {
                  ".validate": "newData.isNumber()"
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "codeOn": {
              ".read": true,
              ".write": "auth != null",
              ".validate": "newData.isBoolean()"
            },
            "code": {
              ".read": true,
              ".write": "auth != null"
            }
          }
        }
      }
    }
  }
}